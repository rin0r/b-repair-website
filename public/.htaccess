# Statischer Export von Next.js auf Apache/LiteSpeed

# Eigene 404-Seite
ErrorDocument 404 /404.html

# Verzeichnisse über index.html ausliefern, kein Datei-Listing
DirectoryIndex index.html
Options -Indexes

# Kanonische Adresse: immer https://b-repair.ch (ohne www).
# Beide Regeln in einem Schritt, damit www + http nur einmal umgeleitet wird.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://b-repair.ch/$1 [R=301,L]
</IfModule>

# Bilder, Schriften und Build-Dateien lange cachen
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp            "access plus 1 year"
  ExpiresByType image/png             "access plus 1 year"
  ExpiresByType image/jpeg            "access plus 1 year"
  ExpiresByType image/svg+xml         "access plus 1 year"
  ExpiresByType text/css              "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/html             "access plus 10 minutes"
</IfModule>

# Kompression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
